{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/system/index.html",
        "http://localhost/blog/index.html",
        "http://localhost/blog/posts/forward-only/index.html",
        "http://localhost/board/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "localhost:[0-9]+/(index|system/index)\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "/(blog|board)/",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1500 }],
            "speed-index": ["error", { "maxNumericValue": 2000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-byte-weight": ["error", { "maxNumericValue": 150000 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "./lhci-report" }
  }
}
